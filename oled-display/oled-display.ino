void setup()
{
  Serial.begin(115200);
  delay(100);
  
  // Инициализация I2C для Blue Pill (SDA = PB7, SCL = PB6)
  Wire.setSDA(PB7);
  Wire.setSCL(PB6);
  Wire.begin();
  
  // Инициализация дисплея
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println("SSD1306 allocation failed");
    for(;;); // Остановка, если дисплей не найден
  }
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("Display OK");
  display.display();
  delay(2000);
  
  display.clearDisplay();
}

void loop()
{
  // Отрисовка изображения
  display.clearDisplay();
  display.drawBitmap(0, 0, epd_bitmap_photo_2026_03_31_09_53_53, 128, 64, SSD1306_WHITE);
  display.display();
  delay(5000); // Пауза 5 секунд, чтобы увидеть изображение
}